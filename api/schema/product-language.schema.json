{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portico.media/schema/product-language.schema.json",
  "title": "Portico Product Language Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "locale", "fallbackLocale", "iconFamily", "icons", "messages"],
  "properties": {
    "revision": { "const": "v1" },
    "locale": { "type": "string", "minLength": 2 },
    "fallbackLocale": { "type": "string", "minLength": 2 },
    "iconFamily": { "const": "lucide" },
    "icons": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9.-]*$" },
      "additionalProperties": { "$ref": "#/$defs/icon" }
    },
    "messages": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9.-]*$" },
      "additionalProperties": { "$ref": "#/$defs/message" }
    }
  },
  "$defs": {
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["glyph", "label"],
      "properties": {
        "glyph": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["text"] }, { "required": ["title"] }],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "icon": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
        "tone": { "enum": ["neutral", "success", "warning", "error"] },
        "actions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^action\\.[a-z][a-z0-9.-]*$" },
          "uniqueItems": true
        }
      }
    }
  }
}
