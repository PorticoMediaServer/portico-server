<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>tv.getportico.server.service</string>
  <key>ProgramArguments</key><array><string>__PORTICO_SERVER_EXECUTABLE__</string></array>
  <key>EnvironmentVariables</key><dict>
    <key>PORTICO_BIND</key><string>0.0.0.0:32500</string>
    <key>PORTICO_STATE_DIR</key><string>__PORTICO_STATE_DIR__</string>
    <key>PORTICO_WEB_DIR</key><string>__PORTICO_WEB_DIR__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__PORTICO_STDOUT__</string>
  <key>StandardErrorPath</key><string>__PORTICO_STDERR__</string>
</dict></plist>
