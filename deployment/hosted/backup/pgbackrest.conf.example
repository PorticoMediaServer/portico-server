# Install as /etc/pgbackrest/pgbackrest.conf (0600). Supply secrets via the
# protected pgBackRest configuration; never put them in arguments or logs.
[global]
repo1-type=s3
repo1-path=/portico-hosted
repo1-s3-bucket=REQUIRED_OFF_PROVIDER_BUCKET
repo1-s3-endpoint=REQUIRED_ENDPOINT
repo1-s3-region=REQUIRED_REGION
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REQUIRED_SECRET_FROM_PRIVATE_CONFIGURATION
repo1-retention-full-type=time
repo1-retention-full=35
compress-type=zst
archive-async=n
start-fast=y
process-max=2
log-level-console=warn

[hosted]
pg1-path=/var/lib/postgresql/16/hosted
pg1-port=5432
