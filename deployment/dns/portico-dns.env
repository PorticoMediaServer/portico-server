# /etc/portico-dns/portico-dns.env (root:portico-dns 0640). No secrets here:
# the feed secret is /etc/portico-dns/feed-secret (portico-dns 0600), the same
# value Hosted holds as --direct-dns-key-file.
DIRECT_DNS_ADDR=127.0.0.1:5353
DIRECT_DNS_ZONE=direct.getportico.tv
DIRECT_DNS_NAMESERVERS=ns1.portico-dns.getportico.tv,ns2.portico-dns.getportico.tv
ACME_DNS_ZONE=acme.getportico.tv
DIRECT_DNS_TABLE_FILE=/var/lib/portico-dns/addresses.json
DIRECT_DNS_FEED_URL=https://web.getportico.tv/v1/dns/addresses
DIRECT_DNS_FEED_SECRET_FILE=/etc/portico-dns/feed-secret
DIRECT_DNS_ALLOW_PRIVATE=false
DIRECT_DNS_CAA_ISSUER_DOMAIN=pki.goog
DIRECT_DNS_CAA_ADDITIONAL_ISSUER_DOMAINS=
DIRECT_DNS_CAA_ACCOUNT_URI=
DIRECT_DNS_TRUSTED_PROXY_CIDRS=127.0.0.1/32
