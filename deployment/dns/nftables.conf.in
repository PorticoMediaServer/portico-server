#!/usr/sbin/nft -f
# /etc/nftables.conf on a DNS node, rendered by scripts/provision-dns-node.sh.
# Public: SSH and DNS (UDP/TCP 53). WireGuard only from the Hosted host and
# the other DNS node; BIND (5354) only over wg0 from those two.
flush ruleset

table inet portico {
	set wg_endpoints {
		type ipv4_addr
		elements = { @HOSTED_PUBLIC_IP@, @PEER_PUBLIC_IP@ }
	}
	set wg_sources {
		type ipv4_addr
		elements = { @HOSTED_WG_IP@, @PEER_WG_IP@ }
	}
	# Authoritative UDP DNS is stateless: keep it out of conntrack so a
	# flood cannot fill the table.
	chain prerouting_raw {
		type filter hook prerouting priority raw; policy accept;
		iifname "@PUBLIC_IF@" udp dport 53 notrack
	}
	chain output_raw {
		type filter hook output priority raw; policy accept;
		oifname "@PUBLIC_IF@" udp sport 53 notrack
	}
	chain input {
		type filter hook input priority filter; policy drop;
		iifname "lo" accept
		udp dport 53 accept
		tcp dport 53 accept
		ct state invalid drop
		ct state established,related accept
		meta l4proto { icmp, ipv6-icmp } accept
		tcp dport 22 accept
		udp sport 67 udp dport 68 accept
		udp sport 547 udp dport 546 accept
		ip saddr @wg_endpoints udp dport 51820 accept
		iifname "wg0" ip saddr @wg_sources meta l4proto { tcp, udp } th dport 5354 accept
		counter drop
	}
	chain forward {
		type filter hook forward priority filter; policy drop;
	}
	chain output {
		type filter hook output priority filter; policy accept;
	}
}
