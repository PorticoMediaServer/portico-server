  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "playwright": "^1.55.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
