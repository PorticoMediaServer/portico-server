{
  "status": "Authored regression cases only; NOT RUN; await checked canonical ReportContext and interval DTOs",
  "authority": "CLAUDE-RULINGS-2026-10-23.md section11",
  "consumerPrinciple": "Capture and propagate device context; assert actual server output; never implement a UI calendar resolver",
  "queryCases": [
    {
      "id": "same-context-every-read",
      "context": {
        "timeZone": "America/Halifax",
        "until": "2026-10-23T15:47:22Z"
      },
      "reads": [
        "people",
        "history",
        "top",
        "playHistory",
        "playSummary",
        "telemetry",
        "peopleAccountPicker",
        "cursorPage"
      ],
      "assert": [
        "each request has the exact timeZone/until pair",
        "filters and opaque cursor are otherwise unchanged",
        "response interval is the actual server interval"
      ]
    },
    {
      "id": "carry-to-full-history",
      "assert": [
        "See full history preserves exact context and selected relevant filters",
        "direct History navigation creates one new context",
        "parent retention effect is unchanged"
      ]
    },
    {
      "id": "device-zone-change",
      "zones": [
        "America/Halifax",
        "Asia/Kathmandu"
      ],
      "assert": [
        "new view transaction captures device zone afresh",
        "old requests abort or their late result is discarded",
        "accumulated rows and cursors clear",
        "no old-zone value is relabelled as new-zone data"
      ]
    },
    {
      "id": "device-utc-is-not-fallback",
      "deviceZone": "UTC",
      "assert": [
        "a real device UTC zone can be sent unchanged",
        "no UTC label is rendered",
        "missing or invalid device zone never silently becomes UTC or server zone"
      ]
    },
    {
      "id": "authority-and-zone-fences",
      "assert": [
        "zone changes never weaken owner/main-profile checks",
        "admin main profile reads only Now playing",
        "secondary profile or stale authority clears private results",
        "context disposal cancels work and listeners"
      ]
    }
  ],
  "producerResponseCases": [
    {
      "id": "halifax-spring-forward-seven-days",
      "request": {
        "period": "7d",
        "timeZone": "America/Halifax",
        "until": "2026-03-09T16:20:00Z"
      },
      "expected": {
        "bucketCount": 7,
        "from": "2026-03-03T04:00:00Z",
        "lastBucketStart": "2026-03-09T03:00:00Z",
        "contains23HourCalendarDay": true
      },
      "consumerAssert": [
        "use returned bounds",
        "do not stretch the DST day to24h",
        "today is partial"
      ]
    },
    {
      "id": "halifax-fall-back-seven-days",
      "request": {
        "period": "7d",
        "timeZone": "America/Halifax",
        "until": "2026-11-02T17:20:00Z"
      },
      "expected": {
        "bucketCount": 7,
        "from": "2026-10-27T03:00:00Z",
        "lastBucketStart": "2026-11-02T04:00:00Z",
        "contains25HourCalendarDay": true
      },
      "consumerAssert": [
        "use returned bounds",
        "do not collapse repeated local hour facts"
      ]
    },
    {
      "id": "thirty-days-not-rolling-hours",
      "request": {
        "period": "30d",
        "timeZone": "Asia/Kathmandu",
        "until": "2026-10-23T12:34:56Z"
      },
      "expected": {
        "bucketCount": 30,
        "from": "2026-09-23T18:15:00Z",
        "lastBucketStart": "2026-10-22T18:15:00Z"
      },
      "consumerAssert": [
        "thirty actual daily buckets",
        "no split of old monthly or weekly points"
      ]
    },
    {
      "id": "ninety-calendar-days",
      "request": {
        "period": "90d",
        "timeZone": "America/Halifax",
        "until": "2026-03-09T16:20:00Z"
      },
      "expected": {
        "bucketCount": 90,
        "from": "2025-12-10T04:00:00Z"
      },
      "consumerAssert": [
        "exactly90 actual daily buckets",
        "no rolling90x24h assumption"
      ]
    },
    {
      "id": "last-year-fifty-two-weeks",
      "request": {
        "period": "1y",
        "timeZone": "America/Halifax",
        "until": "2026-03-09T16:20:00Z"
      },
      "expected": {
        "bucketCount": 52,
        "from": "2025-03-11T03:00:00Z",
        "lastBucketStart": "2026-03-03T04:00:00Z",
        "calendarDays": 364
      },
      "consumerAssert": [
        "use52 actual seven-calendar-day buckets",
        "no365-day label or old monthly points",
        "newest bucket ends at anchor within today"
      ]
    },
    {
      "id": "twelve-hours-quarter-hour-zone",
      "request": {
        "period": "12h",
        "timeZone": "Asia/Kathmandu",
        "until": "2026-10-23T12:34:56Z"
      },
      "expected": {
        "bucketCount": 12,
        "from": "2026-10-23T01:15:00Z",
        "lastBucketStart": "2026-10-23T12:15:00Z"
      },
      "consumerAssert": [
        "last bucket partial",
        "no epoch-hour rounding"
      ]
    },
    {
      "id": "twenty-four-hours-quarter-hour-zone",
      "request": {
        "period": "24h",
        "timeZone": "Asia/Kathmandu",
        "until": "2026-10-23T12:34:56Z"
      },
      "expected": {
        "bucketCount": 24,
        "from": "2026-10-22T13:15:00Z",
        "lastBucketStart": "2026-10-23T12:15:00Z"
      },
      "consumerAssert": [
        "exactly24 real hourly buckets",
        "do not render Today for this interval"
      ]
    },
    {
      "id": "repeated-hour-distinct",
      "request": {
        "period": "12h",
        "timeZone": "America/Halifax",
        "until": "2026-11-01T06:20:00Z"
      },
      "expected": {
        "bucketCount": 12,
        "distinctBucketStarts": [
          "2026-11-01T04:00:00Z",
          "2026-11-01T05:00:00Z"
        ],
        "repeatedLocalHour": 1
      },
      "consumerAssert": [
        "both timestamps remain separate points",
        "never dedupe by formatted local label"
      ]
    },
    {
      "id": "plus-twelve-forty-five",
      "request": {
        "period": "7d",
        "timeZone": "Pacific/Chatham",
        "until": "2026-06-15T12:00:00Z"
      },
      "expected": {
        "bucketCount": 7,
        "from": "2026-06-09T11:15:00Z",
        "lastBucketStart": "2026-06-15T11:15:00Z"
      },
      "consumerAssert": [
        "use returned local-calendar boundaries",
        "retain45-minute-offset facts"
      ]
    },
    {
      "id": "all-time-and-empty",
      "assert": [
        "All-time starts at actual first fact, not an invented midnight",
        "older UTC-day rollups are used only for All-time",
        "empty source remains empty",
        "no migration/backfill/reset occurs in UI"
      ]
    },
    {
      "id": "live-exception",
      "assert": [
        "sent context is validated",
        "actual2-second detail uses moving server-now until",
        "flat returned until/observedAt identify the live read",
        "frozen request context remains the disposal identity",
        "no historical bucket reconstruction"
      ]
    },
    {
      "id": "today-distinct-from-twenty-four-hours",
      "request": {
        "period": "today",
        "timeZone": "Asia/Kathmandu",
        "until": "2026-10-23T12:34:56Z"
      },
      "expected": {
        "bucketCount": 1,
        "from": "2026-10-22T18:15:00Z",
        "until": "2026-10-23T12:34:56Z"
      },
      "consumerAssert": [
        "approved Today sends period=today",
        "24h remains24 hourly buckets",
        "no silent alias or replacement wording"
      ]
    }
  ],
  "canonicalContract": {
    "queryNames": [
      "timeZone",
      "until"
    ],
    "type": "readonly ReportContext {timeZone:string,until:string}",
    "factory": "captureReportContext(timeZone, until?=nowISO)",
    "exports": [
      "admin",
      "root"
    ],
    "telemetrySignature": "ConsoleClient.telemetry(window:TelemetryWindow,context:ReportContext)",
    "responseFields": "flat period/timeZone/from/until/buckets(start/end/partial); DashboardHistory buckets additionally retain kinds",
    "lifetime": "once per view/refresh; See full history carries same context",
    "implementationHold": "No UI source changes or dependent intake until checked generated pin"
  }
}
